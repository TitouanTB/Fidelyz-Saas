generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  logoUrl         String?
  primaryColor    String   @default("#6366f1")
  industry        String?
  description     String?
  websiteUrl      String?
  onboardingDone  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  stripePriceId        String?
  stripeCurrentPeriodEnd DateTime?
  plan                 Plan     @default(FREE)

  members    OrganizationMember[]
  customers  Customer[]
  campaigns  Campaign[]
  messages   Message[]
  pages      PublicPage[]
  analytics  AnalyticsEvent[]

  @@map("organizations")
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           MemberRole   @default(MEMBER)
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

model Customer {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  firstName      String?
  lastName       String?
  phone          String?
  points         Int       @default(0)
  totalSpend     Float     @default(0)
  visitCount     Int       @default(0)
  tags           String[]
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastVisitAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     Message[]
  pointsHistory PointsTransaction[]

  @@unique([organizationId, email])
  @@map("customers")
}

model PointsTransaction {
  id          String   @id @default(cuid())
  customerId  String
  points      Int
  type        PointsType
  description String?
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("points_transactions")
}

enum PointsType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
}

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  description    String?
  type           CampaignType
  status         CampaignStatus @default(DRAFT)
  channels       Channel[]
  subject        String?
  content        String
  scheduledAt    DateTime?
  sentAt         DateTime?
  targetTags     String[]
  minPoints      Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@map("campaigns")
}

enum CampaignType {
  ONE_TIME
  AUTOMATED
  RECURRING
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum Channel {
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

model Message {
  id             String        @id @default(cuid())
  organizationId String
  customerId     String
  campaignId     String?
  channel        Channel
  subject        String?
  content        String
  status         MessageStatus @default(PENDING)
  sentAt         DateTime?
  deliveredAt    DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  metadata       Json?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@map("messages")
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
}

model PublicPage {
  id             String   @id @default(cuid())
  organizationId String
  slug           String
  title          String
  description    String?
  content        Json
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  analyticsEvents AnalyticsEvent[]

  @@unique([organizationId, slug])
  @@map("public_pages")
}

model AnalyticsEvent {
  id             String   @id @default(cuid())
  organizationId String
  pageId         String?
  eventType      String
  properties     Json?
  sessionId      String?
  visitorId      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  page         PublicPage?  @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@map("analytics_events")
}
