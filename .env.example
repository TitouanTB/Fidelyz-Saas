# ===========================================
# Fidelyz SaaS - Environment Variables
# ===========================================

# ===========================================
# Application
# ===========================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Fidelyz

# ===========================================
# Database (Supabase PostgreSQL)
# ===========================================
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ===========================================
# Supabase
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# Stripe
# ===========================================
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_PRICE_ID_STARTER=price_xxx
STRIPE_PRICE_ID_PRO=price_xxx
STRIPE_PRICE_ID_ENTERPRISE=price_xxx

# ===========================================
# Twilio (SMS/WhatsApp)
# ===========================================
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+33xxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ===========================================
# Resend (Email)
# ===========================================
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@yourdomain.com

# ===========================================
# Google AI (Gemini)
# ===========================================
GOOGLE_AI_API_KEY=AIzaxxx

# ===========================================
# Security
# ===========================================
NEXTAUTH_SECRET=your-nextauth-secret-here
JWT_SECRET=your-jwt-secret-here

# ===========================================
# Redis (Optional - for caching/queues)
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# Analytics (Optional)
# ===========================================
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ===========================================
# Apple Wallet
# ===========================================
APPLE_WALLET_CERTIFICATE_PATH=/path/to/certificate.p12
APPLE_WALLET_CERTIFICATE_PASSWORD=your-certificate-password
APPLE_WALLET_PASS_TYPE_ID=pass.com.yourcompany.fidelyz
APPLE_WALLET_TEAM_ID=YOUR_TEAM_ID
APPLE_WALLET_KEY_ID=YOUR_KEY_ID
APPLE_WALLET_PRIVATE_KEY_PATH=/path/to/private-key.p8

# ===========================================
# Feature Flags
# ===========================================
ENABLE_SMS=true
ENABLE_WHATSAPP=true
ENABLE_WALLET=true
ENABLE_AI_SUGGESTIONS=true
