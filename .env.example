# ===========================================
# Fidelyz SaaS - Environment Variables
# ===========================================

# ===========================================
# Application
# ===========================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Fidelyz

# ===========================================
# Database (Supabase PostgreSQL)
# ===========================================
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ===========================================
# Supabase
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# Stripe (Billing)
# ===========================================
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_PRICE_ID_STARTER=price_xxx
STRIPE_PRICE_ID_PRO=price_xxx
STRIPE_PRICE_ID_ENTERPRISE=price_xxx
STRIPE_ALLOW_TRIAL=true

# ===========================================
# Twilio (SMS/WhatsApp)
# ===========================================
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+33xxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ===========================================
# Resend (Email)
# ===========================================
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@yourdomain.com

# ===========================================
# Google AI (Gemini)
# ===========================================
GOOGLE_AI_API_KEY=AIzaxxx

# ===========================================
# Security
# ===========================================
NEXTAUTH_SECRET=your-nextauth-secret-here
JWT_SECRET=your-jwt-secret-here
CRON_SECRET=your-cron-secret-here

# ===========================================
# Redis (Optional - for caching/queues)
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# Analytics (Optional)
# ===========================================
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ===========================================
# Apple Wallet (Optional)
# ===========================================
APPLE_WALLET_CERTIFICATE_PATH=/path/to/certificate.p12
APPLE_WALLET_CERTIFICATE_PASSWORD=your-certificate-password
APPLE_WALLET_PASS_TYPE_ID=pass.com.yourcompany.fidelyz
APPLE_WALLET_TEAM_ID=YOUR_TEAM_ID
APPLE_WALLET_KEY_ID=YOUR_KEY_ID
APPLE_WALLET_PRIVATE_KEY_PATH=/path/to/private-key.p8

# ===========================================
# Google Wallet (Optional)
# ===========================================
GOOGLE_WALLET_ISSUER_ID=your-issuer-id
GOOGLE_WALLET_CLASS_ID=your-class-id
GOOGLE_WALLET_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"..."}'

# ===========================================
# Feature Flags
# ===========================================
# Set to "false" to disable optional services (graceful degradation)

# Messaging channels
ENABLE_SMS=true              # Twilio SMS - set to false to disable
ENABLE_WHATSAPP=true         # Twilio WhatsApp - set to false to disable
ENABLE_EMAIL=true            # Resend email - set to false to disable
ENABLE_PUSH=false            # Push notifications - set to false to disable

# Wallet features
ENABLE_WALLET=true           # Master flag for all wallet features
ENABLE_GOOGLE_WALLET=true    # Google Wallet pass integration
ENABLE_APPLE_WALLET=false    # Apple Wallet pass integration

# AI features
ENABLE_AI_SUGGESTIONS=true   # Google Gemini AI for suggestions

# Analytics
ENABLE_ANALYTICS=true        # Analytics tracking

# Billing
ENABLE_BILLING=true          # Stripe payment integration

# Beta features
ENABLE_BETA_FEATURES=false   # Enable experimental features
